# Copy to .env.local for local dev (gitignored). On Vercel, set these as
# project environment variables instead.
# Backend API base (Render). Local dev can leave this unset (Vite proxies /api → :8000).
VITE_API_URL=https://seedgrant-backend.onrender.com/api/v1
# Optional self-hosted map tiles (defaults to OpenStreetMap public tiles).
# VITE_TILES_URL=https://tiles.example.com/{z}/{x}/{y}.png
