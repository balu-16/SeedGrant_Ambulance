# ---- Detector backend selection (single-variable switch) ----
# onnx = deployment default (ONNX Runtime, fast on Pi ARM CPU).
# pt   = development/debug fallback (Ultralytics PyTorch).
DETECTOR_BACKEND=onnx
ONNX_MODEL_PATH=weights/best.onnx
PT_MODEL_PATH=weights/best.pt
DETECTOR_IMGSZ=640
DETECTOR_CONF=0.25

# ---- Junction identity (ONE folder serves ALL junctions) ----
# Point a Pi at a junction by editing these two lines only — no code changes.
JUNCTION_ID=
DEVICE_API_KEY=

# ---- Cloud ----
BACKEND_URL=http://localhost:8000
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_QOS=1
# HTTP poll fallback interval (s) when MQTT is down/silent.
COMMAND_POLL_INTERVAL_S=8
HEARTBEAT_INTERVAL_S=30
TELEMETRY_INTERVAL_S=3
