# Example client env — copy to .env and fill in the real values.
# Backend base URL: BARE ORIGIN only (e.g. https://seedgrant-backend.onrender.com).
# Do NOT append /api/v1 — services/api.ts adds it (double prefix 404s).
# Dev build / Expo Go on a physical phone must use your LAN IP,
# e.g. http://192.168.1.5:8000 — NOT localhost, which points at the phone itself.
# Production EAS builds inject this per-channel in eas.json; empty here means
# the app shows "App not configured" and login refuses.
EXPO_PUBLIC_API_URL=
# Free routing/tiles (no keys). Defaults work without setting these:
# OSRM demo server (rate-limited — self-host for production).
# EXPO_PUBLIC_OSRM_URL=https://router.project-osrm.org
# Carto light tiles (same look as admin portal).
# EXPO_PUBLIC_TILES_URL=https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}.png
# Push tokens are issued per-device by expo-notifications (services/notifications.ts);
# the EAS projectId lives in app.json → extra.eas.projectId. No manual token here.
