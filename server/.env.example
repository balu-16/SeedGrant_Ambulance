# Copy to .env, then replace every PASTE_* value. Providers default to mock
# so the app boots cleanly; flip to real after pasting keys.
#
# ---------- Supabase (dashboard → Settings → API, and Database → Connect) ----------
# Project URL, e.g. https://abcdefghijklm.supabase.co
SUPABASE_URL=
# Project API keys → anon (public; safe for future mobile use)
SUPABASE_ANON_KEY=PASTE_SUPABASE_ANON_KEY
# Project API keys → service_role (SECRET — server only, never ship to mobile)
SUPABASE_SERVICE_ROLE_KEY=PASTE_SUPABASE_SERVICE_KEY
# Async runtime for the API. Prefer the pooler (:6543) with ?ssl=require, e.g.:
# postgresql+asyncpg://postgres.<ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?ssl=require
DATABASE_URL=PASTE_SUPABASE_POOLER_ASYNCPG_URL
# Sync URL for Alembic/seed/direct access. Database → Connection string → URI (:5432), e.g.:
# postgresql+psycopg://postgres:<db-password>@db.<ref>.supabase.co:5432/postgres?ssl=require
SYNC_DATABASE_URL=PASTE_SUPABASE_DIRECT_PSYCOPG_URL

# ---------- Auth ----------
# Generate: openssl rand -hex 32  (startup refuses <32 chars when ENVIRONMENT=prod)
JWT_SECRET=PASTE_32PLUS_CHAR_RANDOM
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Standard claims verified on every token decode.
JWT_ISSUER=seedgrant
JWT_AUDIENCE=seedgrant-clients

# ---------- App ----------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081
ENVIRONMENT=dev
DEVICE_OFFLINE_AFTER_SECONDS=120
# Sweeper hot-path gate + telemetry retention window.
SWEEP_MIN_INTERVAL_SECONDS=10
DATA_RETENTION_DAYS=30

# ---------- Rate limiting (in-memory sliding window, per client IP) ----------
# Applies to POST /api/v1/auth/*. Only enable X-Forwarded-For handling behind
# a reverse proxy that overwrites the header.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=30
TRUST_PROXY_HEADERS=false

# ---------- Geo / emergency defaults (tune without code changes) ----------
DEFAULT_JUNCTION_RADIUS_M=500.0
COMMAND_TTL_SECONDS=60
EMERGENCY_TTL_MINUTES=60
INACTIVITY_TIMEOUT_MINUTES=5
MIN_MOVING_SPEED_MS=2.0
CROSS_RELEASE_DISTANCE_M=30.0
MAX_GPS_SPEED_MS=90.0
MAX_GPS_ACCURACY_M=50.0
# Reject stale/replayed GPS fixes older than this (seconds).
GPS_MAX_AGE_SECONDS=600
# Re-arm cap per priority command; at the cap the command stays EXPIRED.
MAX_COMMAND_RETRIES=20

# ---------- MQTT: EMQX / HiveMQ (your cluster → connection info) ----------
# mock = no broker needed (messages stored in-memory). real = connect to broker.
MQTT_PROVIDER=mock
# TLS endpoint, e.g. mqtts://<host>.emqx.cloud:8883  (plain: mqtt://<host>:1883)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=PASTE_MQTT_USERNAME
MQTT_PASSWORD=PASTE_MQTT_PASSWORD
MQTT_CLIENT_ID=traffic-backend-01
MQTT_KEEPALIVE=60
MQTT_QOS=1
# Supervised reconnect: exponential backoff 1s→2s→4s… capped here.
MQTT_RECONNECT_MAX_DELAY_SECONDS=30
# Messages queued while offline; oldest dropped (warn-logged) beyond this.
MQTT_OUTBOX_MAX=500

# ---------- Push (Expo Push Service — no credentials needed) ----------
# Firebase Admin JSON is NOT used by this app (push goes through Expo).
# Leave empty unless you implement a direct-FCM path.
FIREBASE_CREDENTIALS_PATH=
